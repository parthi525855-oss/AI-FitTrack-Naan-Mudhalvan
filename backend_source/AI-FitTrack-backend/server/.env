# AI FitTrack API - local environment (git-ignored)
# Generated by the Phase 1 setup. Replace MONGO_URI with your MongoDB Atlas connection string.
PORT=5000

# Credential-free URI (database name in the path = the app's database).
MONGO_URI=mongodb+srv://cluster0.271di5h.mongodb.net/ai-fittrack?retryWrites=true&w=majority&appName=Cluster0

# Credentials are kept separate so the password needs NO URL-encoding.
# Atlas users authenticate against the admin database -> MONGO_AUTH_SOURCE=admin.
MONGO_USER=parthi525855_db_user
MONGO_PASSWORD=2Jesn0KIWv7Ebxll
MONGO_AUTH_SOURCE=admin

# This network's router DNS (10.79.162.101) refuses SRV queries, which breaks
# mongodb+srv:// URIs ("querySrv ECONNREFUSED"). Resolve SRV through public DNS.
DNS_SERVERS=8.8.8.8,1.1.1.1

# This network is NAT64/DNS64 (the shard resolves to 64:ff9b::...), so pin IPv4.
MONGO_FORCE_IPV4=true

JWT_SECRET=b7abc0413d4ea48c88ee5330cc4d8e4c7570e4c501ee6783b4953ae98752c0a6d280dc684df8aab40fa6dae6c4f58209
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# Reserved for Phase 3
GEMINI_API_KEY=AQ.Ab8RN6JQLos8Me83Oljws1H7fyRDAr43WgK0eCZ2yc3MQndKnw
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000

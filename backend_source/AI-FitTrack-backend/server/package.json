{
  "name": "ai-fittrack-api",
  "version": "1.0.0",
  "private": true,
  "description": "AI FitTrack REST API - Phase 1: project setup, MongoDB models and JWT authentication",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "test:smoke": "node tests/smoke/e2e-smoke.js",
    "test:atlas": "node tests/smoke/atlas-check.js",
    "create-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "keywords": [
    "ai-fittrack",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}

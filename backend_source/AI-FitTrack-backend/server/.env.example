# ---------------------------------------------------------------------------
# AI FitTrack API - environment template
# Copy this file to "server/.env" and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Optional credential split: set MONGO_USER + MONGO_PASSWORD (and leave the URI
# credential-free) when the password contains characters such as @ # / % : ? that
# would otherwise have to be URL-encoded inside the connection string.
# Atlas users authenticate against the "admin" database, hence authSource.
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Optional. Only needed when your router / ISP DNS refuses SRV lookups, which
# makes "mongodb+srv://" fail with "querySrv ECONNREFUSED". Leave empty normally.
DNS_SERVERS=

# Optional. Set to true on NAT64/DNS64 networks (mobile hotspots, IPv6-only
# networks) that synthesize IPv6 addresses for Atlas shards.
MONGO_FORCE_IPV4=

# Secret used to sign JWTs. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret

# Token lifetime (e.g. 1d, 12h, 60m)
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Google Gemini API key - REQUIRED for PHASE 3 (/api/ai/* endpoints)
# Get one free at https://aistudio.google.com/apikey, then paste it below.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model used for recommendations + insights (must be available to your key).
# Current supported default: gemini-3.6-flash. Override only if needed.
GEMINI_MODEL=gemini-3.6-flash

# Per-request timeout for Gemini calls (milliseconds, max 120000).
GEMINI_TIMEOUT_MS=30000

# Retry policy for transient Gemini failures only (503 high demand, 429 rate
# limits, timeouts). Invalid keys, unknown/retired models and malformed
# responses are never retried. Total attempts per request, 1..5 (1 = no retry).
GEMINI_MAX_ATTEMPTS=3

# Exponential backoff between attempts: base delay and ceiling (milliseconds).
GEMINI_RETRY_BASE_MS=500
GEMINI_RETRY_MAX_DELAY_MS=5000

# Max AI requests per authenticated user per minute (rate limiting).
AI_RATE_LIMIT_PER_MINUTE=10
